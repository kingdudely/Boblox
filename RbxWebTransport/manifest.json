{
  "manifest_version": 3,
  "name": "RbxWebTransport",
  "version": "0.3.0",
  "description": "Launcher and protocol inspector for Roblox's WebTransport (RbxTransport) game client.",
  "minimum_chrome_version": "113",
  "permissions": ["storage", "tabs", "declarativeNetRequest"],
  "host_permissions": [
    "https://*.roblox.com/*",
    "https://*.rbxcdn.com/*",
    "https://apis.roblox.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ruleset_roblox_ua", "enabled": true, "path": "rules.json" }
    ]
  },
  "action": {
    "default_title": "RbxWebTransport",
    "default_popup": "popup.html"
  }
}
